# Modele instancie au demarrage par l'image nginx : les variables ${PORT} et
# ${BACKEND_URL} sont remplacees par leurs valeurs d'environnement.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Les fichiers produits par Vite portent une empreinte dans leur nom :
    # ils peuvent etre mis en cache indefiniment.
    location /assets/ {
        # Un seul en-tete : `expires` en emettrait un second, et deux
        # Cache-Control concurrents ne sont pas interpretes de la meme facon
        # par tous les caches.
        add_header Cache-Control "public, immutable, max-age=31536000";
        try_files $uri =404;
    }

    # index.html ne doit jamais etre mis en cache, sinon un ancien index
    # continuerait de reclamer des fichiers supprimes au deploiement suivant.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Le navigateur ne voit qu'une seule origine : c'est nginx qui parle au
    # backend.
    #
    # Deux directives sont indispensables des que l'amont est en HTTPS, ce qui
    # est le cas sur Cloud Run :
    #
    #  - `Host $proxy_host` et non `$host` : Cloud Run route les requetes
    #    d'apres l'en-tete Host. Renvoyer celui du frontend ferait chercher un
    #    service qui n'existe pas a cette adresse. `$proxy_host` vaut l'hote
    #    issu de proxy_pass, donc celui du backend.
    #  - `proxy_ssl_server_name on` : sans SNI, le frontal de Cloud Run ne sait
    #    pas quel certificat presenter, la poignee de main TLS echoue et nginx
    #    renvoie 502.
    #
    # En local, l'amont est en HTTP clair sur un nom de service : ces deux
    # directives ne changent rien, d'ou un probleme invisible jusqu'au
    # deploiement.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /actuator/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    # Application a page unique : toute route inconnue rend index.html, sinon
    # un rechargement sur /tasks renverrait un 404 de nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
