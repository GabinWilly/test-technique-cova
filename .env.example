# Copier ce fichier vers .env puis renseigner des valeurs propres a votre machine :
#   cp .env.example .env
#
# Generer un secret :  openssl rand -base64 48

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskuser
MYSQL_PASSWORD=changeme_user
# 3306 par defaut ; 3307 ici car 3306 peut deja etre pris sur la machine hote
MYSQL_PORT=3307

# ---------- Backend Spring Boot ----------
# 8081 car 8080 peut deja etre pris sur la machine hote
SERVER_PORT=8081
JWT_SECRET=changeme_base64_secret_de_256_bits_minimum
JWT_EXPIRATION_MS=86400000

# ---------- Frontend ----------
# 5174 car 5173 (defaut Vite) peut deja etre pris
FRONTEND_PORT=5174

# Origines autorisees par le backend, separees par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# ---------- Pile conteneurisee (docker compose) ----------
# Port du frontend servi par nginx. Distinct de FRONTEND_PORT, qui appartient
# au serveur de developpement Vite : les deux peuvent tourner en meme temps.
WEB_PORT=8082

# Verbosite des logs applicatifs du backend (INFO en deploiement).
APP_LOG_LEVEL=DEBUG
